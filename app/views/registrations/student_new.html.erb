<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7">

      <div class="card shadow-sm">
        <div class="card-header text-center">
          <h2>🎓 Student Registration</h2>
        </div>

        <div class="card-body p-4">

          <% if @student.errors.any? %>
            <div class="alert alert-danger">
              <ul class="mb-0">
                <% @student.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%= form_with model: @student,
                        url: student_register_path,
                        local: true do |form| %>

            <div class="mb-3">
              <%= form.label :name, class: "form-label" %>
              <%= form.text_field :name,
                  class: "form-control",
                  placeholder: "Enter your name" %>
            </div>

            <div class="mb-3">
              <%= form.label :email, class: "form-label" %>
              <%= form.email_field :email,
                  class: "form-control",
                  placeholder: "Enter your email" %>
            </div>

            <div class="mb-3">
              <%= form.label :age, class: "form-label" %>
              <%= form.number_field :age,
                  class: "form-control",
                  min: 1,
                  placeholder: "Enter your age" %>
            </div>

            <div class="mb-3">
              <%= form.label :marks, class: "form-label" %>
              <%= form.number_field :marks,
                  class: "form-control",
                  min: 0,
                  max: 100,
                  placeholder: "Enter your marks" %>
            </div>

            <div class="mb-3">
              <%= form.label :password, class: "form-label" %>
              <%= form.password_field :password,
                  class: "form-control",
                  placeholder: "Create a password" %>
            </div>

            <div class="mb-3">
              <%= form.label :password_confirmation,
                  "Confirm Password",
                  class: "form-label" %>

              <%= form.password_field :password_confirmation,
                  class: "form-control",
                  placeholder: "Confirm your password" %>
            </div>

            <div class="d-grid">
              <%= form.submit "Register as Student",
                  class: "btn btn-primary btn-lg" %>
            </div>

          <% end %>

          <div class="text-center mt-3">
            <%= link_to "Already registered? Student Login",
                student_login_path %>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>

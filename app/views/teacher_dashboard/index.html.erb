<h1>Teacher Dashboard</h1>

<h2>Welcome, <%= @teacher.name %></h2>

<p>
  <strong>Email:</strong>
  <%= @teacher.email %>
</p>

<hr>

<h2>My Courses</h2>

<% if @courses.any? %>

  <ul>
    <% @courses.each do |course| %>
      <li>
        <%= course.name %>
      </li>
    <% end %>
  </ul>

<% else %>

  <p>No courses assigned.</p>

<% end %>

<hr>

<h2>My Students</h2>

<% if @students.any? %>

  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Course</th>
        <th>Marks</th>
      </tr>
    </thead>

    <tbody>
      <% @students.each do |student| %>
        <tr>
          <td><%= student.name %></td>
          <td><%= student.email %></td>
          <td><%= student.course&.name || "Not Assigned" %></td>
          <td><%= student.marks %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

<% else %>

  <p>No students assigned to your courses.</p>

<% end %>

<hr>

<%= button_to "Logout",
    teacher_logout_path,
    method: :delete %>
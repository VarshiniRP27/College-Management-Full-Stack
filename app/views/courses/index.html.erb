<div class="container py-4">

  <!-- ========================= -->
  <!-- Header -->
  <!-- ========================= -->

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>
      <h1 class="mb-1">
        📚 Courses
      </h1>

      <p class="text-muted mb-0">
        Course Management System
      </p>
    </div>

    <% if admin_logged_in? %>

      <%= link_to "➕ Add Course",
          new_course_path,
          class: "btn btn-primary" %>

    <% end %>

  </div>


  <!-- ========================= -->
  <!-- Course Records -->
  <!-- ========================= -->

  <div class="card shadow-sm">

    <div class="card-body">

      <div class="d-flex justify-content-between align-items-center mb-3">

        <h3 class="mb-0">
          📋 Course Records
        </h3>

        <span class="badge bg-secondary">
          <%= @courses.count %> Courses
        </span>

      </div>


      <% if @courses.any? %>

        <div class="table-responsive">

          <table class="table table-hover align-middle">

            <thead class="table-dark">

              <tr>
                <th>ID</th>
                <th>Course Name</th>
                <th>Description</th>
                <th>Teacher</th>
                <th>Students</th>
                <th>Actions</th>
              </tr>

            </thead>


            <tbody>

              <% @courses.each do |course| %>

                <tr>

                  <!-- ID -->

                  <td>
                    <%= course.id %>
                  </td>


                  <!-- Course Name -->

                  <td>

                    <strong>
                      <%= course.name %>
                    </strong>

                  </td>


                  <!-- Description -->

                  <td>

                    <%= course.description %>

                  </td>


                  <!-- Teacher -->

                  <td>

                    <% if course.teacher.present? %>

                      <span class="badge bg-info text-dark">

                        👨‍🏫
                        <%= course.teacher.name %>

                      </span>

                    <% else %>

                      <span class="badge bg-secondary">

                        No Teacher

                      </span>

                    <% end %>

                  </td>


                  <!-- Students -->

                  <td>

                    <span class="badge bg-primary">

                      <%= course.students.count %>

                    </span>

                  </td>


                  <!-- Actions -->

                  <td>

                    <!-- Everyone can view -->

                    <%= link_to "View",

                        course_path(course),

                        class: "btn btn-sm btn-outline-primary" %>


                    <!-- Admin only -->

                    <% if admin_logged_in? %>

                      <%= link_to "Edit",

                          edit_course_path(course),

                          class: "btn btn-sm btn-outline-warning" %>


                      <%= button_to "Delete",

                          course_path(course),

                          method: :delete,

                          class: "btn btn-sm btn-outline-danger",

                          data: {

                            turbo_confirm:
                              "Are you sure you want to delete this course?"

                          } %>

                    <% end %>

                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

      <% else %>

        <!-- ========================= -->
        <!-- No Courses -->
        <!-- ========================= -->

        <div class="alert alert-info text-center">

          <h5>
            No courses found.
          </h5>

          <% if admin_logged_in? %>

            <%= link_to "➕ Add First Course",

                new_course_path,

                class: "btn btn-primary mt-2" %>

          <% end %>

        </div>

      <% end %>

    </div>

  </div>


  <!-- ========================= -->
  <!-- Back to Home -->
  <!-- ========================= -->

  <div class="mt-4">

    <%= link_to "← Back to Home",

        root_path,

        class: "btn btn-secondary" %>

  </div>

</div>
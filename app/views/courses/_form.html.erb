<%= form_with(model: course) do |form| %>

  <% if course.errors.any? %>
    <div class="alert alert-danger">
      <h4>
        <%= pluralize(course.errors.count, "error") %>
        prevented this course from being saved:
      </h4>

      <ul>
        <% course.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, "Course Name", class: "form-label" %>

    <%= form.text_field :name,
        class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, "Description", class: "form-label" %>

    <%= form.text_area :description,
        class: "form-control",
        rows: 5 %>
  </div>

  <div class="mb-3">
    <%= form.label :teacher_id, "Teacher", class: "form-label" %>

    <%= form.collection_select(
      :teacher_id,
      Teacher.order(:name),
      :id,
      :name,
      { include_blank: "Select Teacher" },
      { class: "form-select" }
    ) %>
  </div>

  <div class="mt-4">
    <%= form.submit class: "btn btn-primary" %>

    <%= link_to "Cancel",
        courses_path,
        class: "btn btn-secondary ms-2" %>
  </div>

<% end %>
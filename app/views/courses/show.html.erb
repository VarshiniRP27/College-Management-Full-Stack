<h1><%= @course.name %></h1>

<p>
  <strong>Description:</strong>
  <%= @course.description.presence || "No description" %>
</p>

<p>
  <strong>Teacher:</strong>
  <%= @course.teacher&.name || "Not assigned" %>
</p>

<h2>Students</h2>

<% if @course.students.any? %>
  <ul>
    <% @course.students.order(:name).each do |student| %>
      <li>
        <%= student.name %>
        <% if student.email.present? %>
          — <%= student.email %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No students enrolled in this course.</p>
<% end %>

<br>

<%= link_to "Edit", edit_course_path(@course) %>
|
<%= link_to "Back to Courses", courses_path %>

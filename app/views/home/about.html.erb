<div class="about-page">

  <!-- Hero Section -->
  <section class="about-hero">
    <div class="container">
      <div class="about-hero-content">
        <span class="about-badge">ABOUT US</span>

        <h1>
          Student Management
          <span>Made Simple</span>
        </h1>

        <p>
          A simple and powerful platform to manage student information,
          organize records, and make student management easier.
        </p>
      </div>
    </div>
  </section>


  <!-- About Section -->
  <section class="about-section">
    <div class="container">

      <div class="about-grid">

        <!-- Left Side -->
        <div class="about-content">

          <span class="section-label">WHO WE ARE</span>

          <h2>
            Everything you need to manage students
          </h2>

          <p>
            Student Management App is designed to help schools,
            colleges, teachers, and administrators manage student
            information in one convenient place.
          </p>

          <p>
            Our goal is to make student management simple, organized,
            and efficient. Instead of maintaining student records
            manually, you can manage everything through one application.
          </p>

          <%= link_to "View Students", students_path, class: "about-button" %>

        </div>


        <!-- Right Side -->
        <div class="about-card">

          <div class="about-card-icon">
            🎓
          </div>

          <h3>
            Student Management App
          </h3>

          <p>
            Manage student records, view student information,
            update details, and keep your data organized.
          </p>

        </div>

      </div>

    </div>
  </section>


  <!-- Features Section -->
  <section class="features-section">

    <div class="container">

      <div class="section-heading">
        <span class="section-label">WHAT WE OFFER</span>

        <h2>
          Powerful Features
        </h2>

        <p>
          Everything you need for effective student management.
        </p>
      </div>


      <div class="features-grid">

        <!-- Feature 1 -->
        <div class="feature-card">

          <div class="feature-icon">
            👨‍🎓
          </div>

          <h3>
            Student Records
          </h3>

          <p>
            Store and manage student information in an organized
            and easily accessible way.
          </p>

        </div>


        <!-- Feature 2 -->
        <div class="feature-card">

          <div class="feature-icon">
            📋
          </div>

          <h3>
            Easy Management
          </h3>

          <p>
            Add, view, update, and remove student records
            quickly and efficiently.
          </p>

        </div>


        <!-- Feature 3 -->
        <div class="feature-card">

          <div class="feature-icon">
            🔒
          </div>

          <h3>
            Organized Data
          </h3>

          <p>
            Keep your student information organized and easy
            to manage from one application.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- Call To Action -->
  <section class="about-cta">

    <div class="container">

      <h2>
        Ready to manage your students?
      </h2>

      <p>
        Start managing your student records today.
      </p>

      <%= link_to "Go to Students", students_path, class: "cta-button" %>

    </div>

  </section>

</div>
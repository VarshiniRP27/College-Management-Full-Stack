<div class="container py-5">

  <!-- Welcome Section -->

  <div class="text-center mb-5">

    <h1 class="display-4 fw-bold">
      🎓 Student Management System
    </h1>

    <p class="lead text-muted">
      Manage and view student records easily
    </p>

  </div>


  <!-- Navigation Buttons -->

  <div class="row g-4 justify-content-center">

  <!-- Admin Login -->

<div class="text-center mt-5">

  <% if admin_logged_in? %>

    <%= link_to "⚙️ Admin",
        teachers_path,
        class: "btn btn-dark btn-lg" %>

    <%= button_to "🚪 Logout",
        admin_logout_path,
        method: :delete,
        class: "btn btn-outline-danger mt-2" %>

  <% else %>

    <%= link_to "🔐 Admin Login",
        admin_login_path,
        class: "btn btn-dark btn-lg" %>

  <% end %>

</div>


    <!-- View Students -->

    <div class="col-md-4">

      <div class="card shadow-sm h-100">

        <div class="card-body text-center p-4">

          <div class="fs-1">
            📋
          </div>

          <h4 class="mt-3">
            All Students
          </h4>

          <p class="text-muted">
            View all student records
          </p>

          <%= link_to "View Students",
              students_path,
              class: "btn btn-primary" %>

        </div>

      </div>

    </div>


    <!-- Find Student -->

    <div class="col-md-4">

      <div class="card shadow-sm h-100">

        <div class="card-body text-center p-4">

          <div class="fs-1">
            🔍
          </div>

          <h4 class="mt-3">
            Find Student
          </h4>

          <p class="text-muted">
            Search a student using ID
          </p>

          <%= link_to "Find Student",
              find_student_path,
              class: "btn btn-primary" %>

        </div>

      </div>

    </div>


    <!-- Statistics -->

    <div class="col-md-4">

      <div class="card shadow-sm h-100">

        <div class="card-body text-center p-4">

          <div class="fs-1">
            📊
          </div>

          <h4 class="mt-3">
            Statistics
          </h4>

          <p class="text-muted">
            View student performance statistics
          </p>

          <%= link_to "View Statistics",
              student_statistics_path,
              class: "btn btn-success" %>

        </div>

      </div>

    </div>
    

<!-- Teachers -->

<div class="col-md-4">

  <div class="card shadow-sm h-100">

    <div class="card-body text-center p-4">

      <div class="fs-1">
        👨‍🏫
      </div>

      <h4 class="mt-3">
        Teachers
      </h4>

      <p class="text-muted">
        View teachers and the courses they teach
      </p>

      <%= link_to "View Teachers",
          teachers_path,
          class: "btn btn-info" %>

    </div>

  </div>

</div>
    <!-- Add Student -->

    <% if admin_logged_in? %>

      <div class="col-md-4">

        <div class="card shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div class="fs-1">
              ➕
            </div>

            <h4 class="mt-3">
              Add Student
            </h4>

            <p class="text-muted">
              Add a new student record
            </p>

            <%= link_to "Add Student",
                new_student_path,
                class: "btn btn-warning" %>

          </div>

        </div>

      </div>

    <% end %>
    


    <!-- About -->

    <div class="col-md-4">

      <div class="card shadow-sm h-100">

        <div class="card-body text-center p-4">

          <div class="fs-1">
            ℹ️
          </div>

          <h4 class="mt-3">
            About
          </h4>

          <p class="text-muted">
            Learn about the Student Management System
          </p>

          <%= link_to "About Us",
              home_about_path,
              class: "btn btn-secondary" %>

        </div>

      </div>

    </div>

  </div>

</div>
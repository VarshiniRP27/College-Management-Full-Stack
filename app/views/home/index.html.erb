<div class="container py-5">

  <div class="text-center mb-5">
    <h1 class="display-4 fw-bold">
      🎓 Student Management System
    </h1>

    <p class="lead text-muted">
      Manage students, teachers and courses easily
    </p>
  </div>


  <% if admin_logged_in? %>

    <div class="text-center mb-4">
      <h2>⚙️ Admin Dashboard</h2>
      <p class="text-muted">Manage the entire system</p>
    </div>

    <div class="row g-4 justify-content-center">

      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-body text-center p-4">
            <div class="fs-1">👨‍🏫</div>
            <h4 class="mt-3">Teachers</h4>
            <p class="text-muted">Add, edit, view and delete teachers</p>

            <%= link_to "Manage Teachers",
                teachers_path,
                class: "btn btn-info" %>
          </div>
        </div>
      </div>


      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-body text-center p-4">
            <div class="fs-1">🎓</div>
            <h4 class="mt-3">Students</h4>
            <p class="text-muted">Add, edit, view and delete students</p>

            <%= link_to "Manage Students",
                students_path,
                class: "btn btn-primary" %>
          </div>
        </div>
      </div>


      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-body text-center p-4">
            <div class="fs-1">📚</div>
            <h4 class="mt-3">Courses</h4>
            <p class="text-muted">Add, edit, view and delete courses</p>

            <%= link_to "Manage Courses",
                courses_path,
                class: "btn btn-warning" %>
          </div>
        </div>
      </div>


      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-body text-center p-4">
            <div class="fs-1">📝</div>
            <h4 class="mt-3">Enrollments</h4>
            <p class="text-muted">
              Enroll students in courses and manage enrollments
            </p>

            <%= link_to "Manage Enrollments",
                enrollments_path,
                class: "btn btn-success" %>
          </div>
        </div>
      </div>

    </div>

    <div class="text-center mt-5">
      <%= button_to "🚪 Admin Logout",
          admin_logout_path,
          method: :delete,
          class: "btn btn-outline-danger" %>
    </div>


  <% elsif session[:teacher_id].present? %>

    <div class="text-center mb-4">
      <h2>👨‍🏫 Teacher Dashboard</h2>
      <p class="text-muted">View your courses and students</p>
    </div>

    <div class="row g-4 justify-content-center">

      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-body text-center p-4">
            <div class="fs-1">🏠</div>
            <h4 class="mt-3">My Dashboard</h4>
            <p class="text-muted">View your teacher dashboard</p>

            <%= link_to "My Dashboard",
                teacher_dashboard_path,
                class: "btn btn-info" %>
          </div>
        </div>
      </div>


      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-body text-center p-4">
            <div class="fs-1">📚</div>
            <h4 class="mt-3">My Courses</h4>
            <p class="text-muted">View courses assigned to you</p>

            <%= link_to "My Courses",
                teacher_dashboard_path,
                class: "btn btn-primary" %>
          </div>
        </div>
      </div>


      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-body text-center p-4">
            <div class="fs-1">👨‍🎓</div>
            <h4 class="mt-3">My Students</h4>
            <p class="text-muted">View students in your courses</p>

            <%= link_to "My Students",
                teacher_dashboard_path,
                class: "btn btn-success" %>
          </div>
        </div>
      </div>

    </div>

    <div class="text-center mt-5">
      <%= button_to "🚪 Teacher Logout",
          teacher_logout_path,
          method: :delete,
          class: "btn btn-outline-danger" %>
    </div>


  <% elsif session[:student_id].present? %>

    <div class="text-center mb-4">
      <h2>🎓 Student Dashboard</h2>
      <p class="text-muted">View your profile, course and results</p>
    </div>

    <div class="row g-4 justify-content-center">

      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-body text-center p-4">
            <div class="fs-1">🏠</div>
            <h4 class="mt-3">My Dashboard</h4>
            <p class="text-muted">View your student dashboard</p>

            <%= link_to "My Dashboard",
                student_dashboard_path,
                class: "btn btn-primary" %>
          </div>
        </div>
      </div>


      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-body text-center p-4">
            <div class="fs-1">👤</div>
            <h4 class="mt-3">My Profile</h4>
            <p class="text-muted">View and edit your profile</p>

            <%= link_to "My Profile",
                student_dashboard_path,
                class: "btn btn-info" %>
          </div>
        </div>
      </div>


      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-body text-center p-4">
            <div class="fs-1">📚</div>
            <h4 class="mt-3">My Courses</h4>
            <p class="text-muted">View your enrolled courses</p>

            <%= link_to "My Courses",
                student_dashboard_path,
                class: "btn btn-success" %>
          </div>
        </div>
      </div>

    </div>

    <div class="text-center mt-5">
      <%= button_to "🚪 Student Logout",
          student_logout_path,
          method: :delete,
          class: "btn btn-outline-danger" %>
    </div>


  <% else %>

    <div class="text-center mb-5">
      <h2>Welcome!</h2>

      <p class="text-muted">
        Please select your login or registration type to continue.
      </p>
    </div>


    <div class="row g-4 justify-content-center">

      <!-- ADMIN -->

      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-body text-center p-4">

            <div class="fs-1">⚙️</div>

            <h4 class="mt-3">Admin</h4>

            <p class="text-muted">
              Manage the entire system
            </p>

            <%= link_to "Admin Login",
                admin_login_path,
                class: "btn btn-danger" %>

          </div>
        </div>
      </div>


      <!-- TEACHER -->

      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-body text-center p-4">

            <div class="fs-1">👨‍🏫</div>

            <h4 class="mt-3">Teacher</h4>

            <p class="text-muted">
              Login or create a teacher account
            </p>

            <div class="d-flex justify-content-center gap-2">

              <%= link_to "Teacher Login",
                  teacher_login_path,
                  class: "btn btn-info" %>

              <%= link_to "Register",
                  teacher_register_path,
                  class: "btn btn-outline-info" %>

            </div>

          </div>
        </div>
      </div>


      <!-- STUDENT -->

      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-body text-center p-4">

            <div class="fs-1">🎓</div>

            <h4 class="mt-3">Student</h4>

            <p class="text-muted">
              Login or create a student account
            </p>

            <div class="d-flex justify-content-center gap-2">

              <%= link_to "Student Login",
                  student_login_path,
                  class: "btn btn-primary" %>

              <%= link_to "Register",
                  student_register_path,
                  class: "btn btn-outline-primary" %>

            </div>

          </div>
        </div>
      </div>

    </div>

  <% end %>

</div>

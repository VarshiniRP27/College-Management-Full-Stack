
<div class="container py-4">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>
      <h1 class="mb-1">
        🎓 Students
      </h1>

      <p class="text-muted mb-0">
        Student Management System
      </p>
    </div>

    <% if admin_logged_in? %>
      <%= link_to "➕ Add Student",
          new_student_path,
          class: "btn btn-primary" %>
    <% end %>

  </div>


  <!-- ========================= -->
  <!-- Course Filter -->
  <!-- ========================= -->

  <div class="card shadow-sm mb-4">

    <div class="card-body">

      <h5 class="mb-3">
        🔍 Filter Students by Course
      </h5>

      <%= form_with url: students_path,
          method: :get,
          local: true,
          class: "row g-3 align-items-end" do |form| %>

        <div class="col-md-5">

          <%= form.label :course_id,
              "Select Course",
              class: "form-label" %>

          <%= form.select :course_id,

              options_for_select(
                [["All Courses", ""]] +
                @courses.map { |course| [course.name, course.id] },
                params[:course_id]
              ),

              {},

              class: "form-select" %>

        </div>


        <div class="col-md-auto">

          <%= form.submit "🔍 Filter",
              class: "btn btn-primary" %>

        </div>


        <div class="col-md-auto">

          <%= link_to "Clear Filter",
              students_path,
              class: "btn btn-secondary" %>

        </div>

      <% end %>

    </div>

  </div>


  <!-- ========================= -->
  <!-- Student Records -->
  <!-- ========================= -->

  <div class="card shadow-sm">

    <div class="card-body">

      <div class="d-flex justify-content-between align-items-center mb-3">

        <h3 class="mb-0">
          📋 Student Records
        </h3>

        <span class="badge bg-secondary">
          <%= @students.count %> Students
        </span>

      </div>


      <!-- ========================= -->
      <!-- Student Table -->
      <!-- ========================= -->

      <% if @students.any? %>

        <div class="table-responsive">

          <table class="table table-hover align-middle">

            <thead class="table-dark">

              <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Age</th>
                <th>Course</th>
                <th>Marks</th>
                <th>Result</th>
                <th>Actions</th>
              </tr>

            </thead>


            <tbody>

              <% @students.each do |student| %>

                <tr>

                  <!-- ID -->

                  <td>
                    <%= student.id %>
                  </td>


                  <!-- Name -->

                  <td>
                    <strong>
                      <%= student.name %>
                    </strong>
                  </td>


                  <!-- Email -->

                  <td>
                    <%= student.email.presence || "Not Provided" %>
                  </td>


                  <!-- Age -->

                  <td>
                    <%= student.age.presence || "N/A" %>
                  </td>


                  <!-- Course -->

                  <td>

                    <span class="badge bg-info text-dark">

                      <%= student.course&.name || "Not Assigned" %>

                    </span>

                  </td>


                  <!-- Marks -->

                  <td>

                    <strong>
                      <%= student.marks %>
                    </strong>

                  </td>


                  <!-- Result -->

                  <td>

                    <% if student.result == "PASS" %>

                      <span class="badge bg-success">
                        PASS
                      </span>

                    <% else %>

                      <span class="badge bg-danger">
                        FAIL
                      </span>

                    <% end %>

                  </td>


                  <!-- Actions -->

                  <td>

                    <%= link_to "View",
                        student_path(student),
                        class: "btn btn-sm btn-outline-primary" %>


                    <% if admin_logged_in? %>

                      <%= link_to "Edit",
                          edit_student_path(student),
                          class: "btn btn-sm btn-outline-warning" %>


                      <%= button_to "Delete",
                          student_path(student),
                          method: :delete,
                          class: "btn btn-sm btn-outline-danger",
                          data: {
                            turbo_confirm:
                              "Are you sure you want to delete this student?"
                          } %>

                    <% end %>

                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>


        <!-- ========================= -->
        <!-- Pagination -->
        <!-- ========================= -->

        <% if @pagy.pages > 1 %>

          <div class="d-flex justify-content-center align-items-center mt-4">

            <nav aria-label="Student pagination">

              <div class="d-flex align-items-center gap-1">


                <!-- Previous -->

                <% if @pagy.prev %>

                  <%= link_to "← Previous",

                      students_path(
                        page: @pagy.prev,
                        course_id: params[:course_id]
                      ),

                      class: "btn btn-outline-primary" %>

                <% else %>

                  <span class="btn btn-outline-secondary disabled">
                    ← Previous
                  </span>

                <% end %>


                <!-- Page Numbers -->

                <% @pagy.series.each do |item| %>

                  <% if item.is_a?(Integer) %>

                    <%= link_to item,

                        students_path(
                          page: item,
                          course_id: params[:course_id]
                        ),

                        class: "btn btn-outline-primary" %>

                  <% elsif item == "gap" %>

                    <span class="px-2">
                      ...
                    </span>

                  <% end %>

                <% end %>


                <!-- Next -->

                <% if @pagy.next %>

                  <%= link_to "Next →",

                      students_path(
                        page: @pagy.next,
                        course_id: params[:course_id]
                      ),

                      class: "btn btn-outline-primary" %>

                <% else %>

                  <span class="btn btn-outline-secondary disabled">
                    Next →
                  </span>

                <% end %>

              </div>

            </nav>

          </div>


          <!-- Page Information -->

          <div class="text-center text-muted mt-3">

            Page
            <strong><%= @pagy.page %></strong>

            of

            <strong><%= @pagy.pages %></strong>

          </div>

        <% end %>


      <% else %>

        <!-- ========================= -->
        <!-- No Students -->
        <!-- ========================= -->

        <div class="alert alert-info text-center">

          <h5>
            No students found.
          </h5>

          <% if params[:course_id].present? %>

            <p class="mb-2">
              No students are assigned to the selected course.
            </p>

          <% else %>

            <p class="mb-2">
              There are no students yet.
            </p>

          <% end %>


          <%= link_to "View All Students",
              students_path,
              class: "btn btn-link" %>

        </div>

      <% end %>

    </div>

  </div>


  <!-- ========================= -->
  <!-- Back to Home -->
  <!-- ========================= -->

  <div class="mt-4">

    <%= link_to "← Back to Home",
        root_path,
        class: "btn btn-secondary" %>

  </div>

</div>


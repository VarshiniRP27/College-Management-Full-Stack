
<div class="container py-4">

  <!-- Header -->

  <div class="text-center mb-4">

    <h1>
      📊 Student Statistics
    </h1>

    <p class="text-muted">
      Overview of student performance
    </p>

  </div>


  <!-- ========================= -->
  <!-- Student Count Statistics -->
  <!-- ========================= -->

  <div class="row g-4 mb-4">

    <!-- Total Students -->

    <div class="col-md-4">

      <div class="card shadow-sm text-center h-100">

        <div class="card-body">

          <h5 class="text-muted">
            👨‍🎓 Total Students
          </h5>

          <h2 class="display-5">
            <%= @total_students %>
          </h2>

          <p class="mb-0">
            Students
          </p>

        </div>

      </div>

    </div>


    <!-- Passed -->

    <div class="col-md-4">

      <div class="card shadow-sm text-center h-100">

        <div class="card-body">

          <h5 class="text-muted">
            ✅ Passed Students
          </h5>

          <h2 class="display-5 text-success">
            <%= @passed_students %>
          </h2>

          <p class="mb-0">
            Students
          </p>

        </div>

      </div>

    </div>


    <!-- Failed -->

    <div class="col-md-4">

      <div class="card shadow-sm text-center h-100">

        <div class="card-body">

          <h5 class="text-muted">
            ❌ Failed Students
          </h5>

          <h2 class="display-5 text-danger">
            <%= @failed_students %>
          </h2>

          <p class="mb-0">
            Students
          </p>

        </div>

      </div>

    </div>

  </div>


  <!-- ========================= -->
  <!-- Marks Statistics -->
  <!-- ========================= -->

  <div class="row g-4 mb-4">

    <!-- Highest -->

    <div class="col-md-4">

      <div class="card shadow-sm text-center h-100">

        <div class="card-body">

          <h5 class="text-muted">
            🏆 Highest Marks
          </h5>

          <h2 class="display-5">
            <%= @highest_marks %>
          </h2>

          <p class="mb-0">
            Marks
          </p>

        </div>

      </div>

    </div>


    <!-- Lowest -->

    <div class="col-md-4">

      <div class="card shadow-sm text-center h-100">

        <div class="card-body">

          <h5 class="text-muted">
            📉 Lowest Marks
          </h5>

          <h2 class="display-5">
            <%= @lowest_marks %>
          </h2>

          <p class="mb-0">
            Marks
          </p>

        </div>

      </div>

    </div>


    <!-- Average -->

    <div class="col-md-4">

      <div class="card shadow-sm text-center h-100">

        <div class="card-body">

          <h5 class="text-muted">
            📈 Average Marks
          </h5>

          <h2 class="display-5">
            <%= number_with_precision(
                  @average_marks,
                  precision: 2
                ) %>
          </h2>

          <p class="mb-0">
            Marks
          </p>

        </div>

      </div>

    </div>

  </div>


  <!-- ========================= -->
  <!-- Pass Percentage -->
  <!-- ========================= -->

  <div class="card shadow-sm mb-4">

    <div class="card-body text-center">

      <h5 class="text-muted">
        📊 Pass Percentage
      </h5>

      <h2 class="display-4">
        <%= @pass_percentage %>%
      </h2>

      <p class="mb-0">
        Overall pass percentage
      </p>

    </div>

  </div>


  <!-- Back -->

  <div class="mt-4">

    <%= link_to "← Back to Students",
        students_path,
        class: "btn btn-secondary" %>

  </div>

</div>


<%= form_with(model: student) do |form| %>

  <% if student.errors.any? %>
    <div class="alert alert-danger">
      <h4>
        <%= pluralize(student.errors.count, "error") %>
        prevented this student from being saved:
      </h4>

      <ul>
        <% student.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, "Name", class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :email, "Email", class: "form-label" %>
    <%= form.email_field :email, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :age, "Age", class: "form-label" %>
    <%= form.number_field :age, class: "form-control", min: 1 %>
  </div>

  <div class="mb-3">
    <%= form.label :password, "New Password", class: "form-label" %>
    <%= form.password_field :password,
        class: "form-control",
        placeholder: "Leave blank to keep current password" %>
  </div>

  <div class="mb-3">
    <%= form.label :password_confirmation,
        "Confirm New Password",
        class: "form-label" %>

    <%= form.password_field :password_confirmation,
        class: "form-control",
        placeholder: "Leave blank to keep current password" %>
  </div>

  <% unless student.persisted? %>

    <div class="mb-3">
      <%= form.label :marks, "Marks", class: "form-label" %>

      <%= form.number_field :marks,
          class: "form-control",
          min: 0,
          max: 100 %>
    </div>

    <div class="mb-3">
      <%= form.label :course_id, "Course", class: "form-label" %>

      <%= form.collection_select(
        :course_id,
        Course.order(:name),
        :id,
        :name,
        { include_blank: "Select Course" },
        { class: "form-select" }
      ) %>
    </div>

  <% end %>

  <div class="mt-4">

    <%= form.submit(
      student.persisted? ? "Update Profile" : "Create Student",
      class: "btn btn-primary"
    ) %>

    <%= link_to "Cancel",
        student.persisted? ? student_path(student) : students_path,
        class: "btn btn-secondary ms-2" %>

  </div>

<% end %>
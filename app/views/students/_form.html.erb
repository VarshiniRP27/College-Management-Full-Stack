<%= form_with(model: student) do |form| %>

  <% if student.errors.any? %>
    <div class="alert alert-danger">
      <h5>
        <%= pluralize(student.errors.count, "error") %>
        prevented this student from being saved:
      </h5>

      <ul>
        <% student.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, "Name", class: "form-label" %>

    <%= form.text_field :name,
        class: "form-control",
        placeholder: "Enter student name" %>
  </div>

  <div class="mb-3">
    <%= form.label :age, "Age", class: "form-label" %>

    <%= form.number_field :age,
        class: "form-control",
        placeholder: "Enter age",
        min: 1 %>
  </div>

  <div class="mb-3">
    <%= form.label :course, "Course", class: "form-label" %>

    <%= form.text_field :course,
        class: "form-control",
        placeholder: "e.g. CSE, ECE, EEE" %>
  </div>

  <div class="mb-3">
    <%= form.label :marks, "Marks", class: "form-label" %>

    <%= form.number_field :marks,
        class: "form-control",
        placeholder: "Enter marks",
        min: 0,
        max: 100 %>
  </div>

  <div>
    <%= form.submit "Save Student", class: "btn btn-primary" %>
  </div>

<% end %>